					],
					"port": "5000",
					"path": [
						"api",
						"products",
						"categories"
					]
				},
				"description": "Get all unique product categories"
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
