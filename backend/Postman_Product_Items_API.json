			},
			"response": []
		},
		{
			"name": "Get Items by Category",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:5000/api/products/items/category?category=Pizza",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5000",
					"path": [
						"api",
						"products",
						"items",
						"category"
					],
					"query": [
						{
							"key": "category",
							"value": "Pizza",
							"description": "Category name to filter by"
						}
					]
				},
				"description": "Get all product items filtered by a specific category"
			},
			"response": []
		},
		{
			"name": "Get All Categories",
			"request": {
				"method": "GET",
				"header": [],
